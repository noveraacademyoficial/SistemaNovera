# Dados reais do sistema (alunos, pagamentos, contas, senhas com hash) e os
# backups automáticos — não versionados por conterem dados pessoais/sensíveis
dados/

# Planilha original, com os mesmos dados reais dos alunos
*.xlsx

# Variaveis de ambiente locais (senhas de bootstrap, etc.)
.env
.env.local

# Cruft comum de SO/editor
Thumbs.db
.DS_Store
node_modules/

# Symlinks locais criados por "npx skills add" (caminho absoluto, só valem
# nesta máquina) — o conteúdo de verdade dos skills fica em .agents/skills/,
# que é o que vai pro Git. Recria sozinho rodando "npx skills add" de novo.
.claude/skills/
